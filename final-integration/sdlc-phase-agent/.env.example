REQUESTS_FILE=data/requests.json

# Security / abuse prevention
RATE_LIMIT_PER_MINUTE=20
MAX_REQUESTS_PER_SESSION=50

# Any OpenAI-compatible provider works. Pick one block.

# Option A: Groq (free tier) - https://console.groq.com/keys
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
USE_LOGPROBS=false

# Option B: Google Gemini (free tier) - https://aistudio.google.com/apikey
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash
# USE_LOGPROBS=false

# Option C: Ollama (local, no key needed) - `ollama pull llama3.2`
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2
# USE_LOGPROBS=false

# Option D: OpenAI (paid)
# OPENAI_MODEL=gpt-4o-mini
# USE_LOGPROBS=true
